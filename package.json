{
  "name": "daloy-web",
  "version": "0.0.1-alpha.1",
  "private": true,
  "scripts": {
    "turbo": "next dev --turbopack",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:merge": "tsx prisma/merge-schema.ts",
    "prisma:generate": "npm run prisma:merge && prisma generate",
    "prisma:push": "npm run prisma:merge && prisma db push",
    "prisma:push:force": "npm run prisma:merge && prisma db push --force-reset",
    "prisma:migrate:dev": "npm run prisma:merge && prisma migrate dev",
    "prisma:migrate:deploy": "npm run prisma:merge && prisma migrate deploy",
    "prisma:migrate:reset": "npm run prisma:merge && prisma migrate reset"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@prisma/client": "^6.5.0",
    "@turf/bbox": "^7.2.0",
    "bootstrap": "^5.3.5",
    "clsx": "^2.1.1",
    "libphonenumber-js": "^1.12.7",
    "maplibre-gl": "^5.3.1",
    "maplibre-gl-draw": "^1.6.9",
    "next": "15.2.4",
    "next-auth": "^5.0.0-beta.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.55.0",
    "react-phone-number-input": "^3.4.12",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/bootstrap": "^5.2.10",
    "@types/mapbox__mapbox-gl-draw": "^1.4.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.2.4",
    "prisma": "^6.5.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5"
  }
}
