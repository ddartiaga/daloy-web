model Customer {
    customerId         String    @id
    classification     String
    status             String
    cistern            String
    connectionDate     DateTime?
    meterId            String?
    meterBrand         String?
    meterSize          String?
    lastName           String
    firstName          String
    middleName         String?
    address            String
    primaryContact     String
    alternativeContact String?
    createdAt          DateTime  @default(now())
    updatedAt          DateTime  @updatedAt

    features GeoFeature?
}

model GeoFeature {
    id         String   @id
    entity     String
    properties Json
    feature    Json
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    // Foreign key relation to Customer
    customerId String   @unique
    customer   Customer @relation(fields: [customerId], references: [customerId])
}
